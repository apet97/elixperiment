## Runtime configuration for PumbleAutomation
##
## This file documents every variable read by `PumbleAutomation.Config`
## (lib/pumble_automation/config.ex) through `config/runtime.exs`.
##
## It contains NO real values. Copy it, fill it in through your secret
## manager, and inject the result into the production release environment.
## Never commit a filled-in copy: `.env` and `.env.*` are gitignored.
##
## Sensitivity levels:
##   public   - safe to log and to show in dashboards
##   internal - not a credential, but do not publish
##   secret   - credential or key material; never log, never commit
##
## Development and test do not need this file. `config/dev.exs` and
## `config/test.exs` carry their own non-production placeholders.

# --- Database ------------------------------------------------------------

# DATABASE_URL (required, secret)
# Purpose: PostgreSQL connection URL for PumbleAutomation.Repo.
# Format:  ecto://USER:PASSWORD@HOST:PORT/DATABASE
# Rotation: rotate the database password, then redeploy. Existing connections
#           are dropped on restart; migrations must be re-verified afterwards.
DATABASE_URL=

# DATABASE_SSL (optional, public, default: true)
# Purpose: require TLS for database connections. Set to false only for a
#          local or private-network database that cannot offer TLS.
# Values:  true, false, 1, 0, yes, no
# Rotation: none.
DATABASE_SSL=true

# POOL_SIZE (optional, public, default: 10, range 1-100)
# Purpose: connection pool size per node.
# Rotation: none. Raising it must stay within the server max_connections.
POOL_SIZE=10

# ECTO_IPV6 (optional, public, default: false)
# Purpose: connect to the database over IPv6.
# Rotation: none.
ECTO_IPV6=false

# --- Endpoint ------------------------------------------------------------

# PUBLIC_BASE_URL (required, public)
# Purpose: canonical public URL of this deployment. It defines the endpoint
#          host, scheme, and port, and is the base of every OAuth redirect,
#          callback, and generated link. No path, query, or fragment.
# Format:  https://automation.example.com
# Rotation: changing it invalidates the URLs registered in the Pumble app
#           manifest. Update the manifest in the same change window.
PUBLIC_BASE_URL=

# PORT (optional, public, default: 4000, range 1-65535)
# Purpose: TCP port the HTTP server binds to inside the container.
# Rotation: none.
PORT=4000

# SECRET_KEY_BASE (required, secret, minimum 64 characters)
# Purpose: signs and encrypts cookies, LiveView sessions, and other tokens.
# Generate: mix phx.gen.secret
# Rotation: invalidates every browser session and signed token immediately.
#           All users must sign in again.
SECRET_KEY_BASE=

# SESSION_SIGNING_SALT (required, secret, minimum 8 characters)
# Purpose: salt for signed session cookies and LiveView sessions.
# Generate: mix phx.gen.secret 32
# Rotation: invalidates existing browser sessions. Users must sign in again.
SESSION_SIGNING_SALT=

# DNS_CLUSTER_QUERY (optional, internal)
# Purpose: DNS query used to discover sibling nodes for clustering.
# Rotation: none.
DNS_CLUSTER_QUERY=

# LOG_LEVEL (optional, public, default: info)
# Purpose: production Logger level. No code change required.
# Values:  emergency, alert, critical, error, warning, notice, info, debug
# Rotation: none.
LOG_LEVEL=info

# --- Pumble application identity -----------------------------------------

# PUMBLE_CLIENT_ID (required, internal)
# Purpose: OAuth client identifier of the Pumble marketplace application.
# Rotation: issued with the client secret. Changing it requires re-installing
#           the application in every workspace.
PUMBLE_CLIENT_ID=

# PUMBLE_CLIENT_SECRET (required, secret, minimum 16 characters)
# Purpose: OAuth client secret used in the authorization code exchange.
# Rotation: rotate in the Pumble developer console and redeploy. Installations
#           already authorized keep working; new authorizations fail until the
#           new value is deployed.
PUMBLE_CLIENT_SECRET=

# PUMBLE_APP_KEY (required, secret, minimum 16 characters)
# Purpose: sent as the `x-app-token` header on every Pumble API call. Pumble
#          answers 401 when it is missing or wrong.
# Rotation: rotate in the Pumble developer console and redeploy. Every outbound
#           API call fails until the new value is deployed.
PUMBLE_APP_KEY=

# PUMBLE_SIGNING_SECRET (required, secret, minimum 16 characters)
# Purpose: verifies the signature on inbound Pumble callbacks and events.
# Rotation: inbound callbacks are rejected until the new value is deployed.
#           Rotate during a maintenance window and expect replayed deliveries.
PUMBLE_SIGNING_SECRET=

# PUMBLE_BOT_SCOPES (required, public)
# Purpose: comma-separated bot permissions requested during installation.
# Choose only permissions required by the enabled workflows. Use catalog names
# without a `bot:` prefix; the consent URL adds that prefix. At least one scope
# is required, and blank or duplicate entries are rejected.
# Values: messages:read, messages:write, messages:edit, messages:delete,
#         attachments:write, user:read, status:write, reaction:read,
#         reaction:write, channels:list, channels:read, channels:write,
#         users:list, workspace:read, calls:write, files:write
# Rotation: changing the requested set requires reinstalling the application.
PUMBLE_BOT_SCOPES=

# PUMBLE_USER_SCOPES (optional, public, default: empty)
# Purpose: comma-separated user permissions requested during installation.
# Keep empty unless a user-token feature needs a catalog scope. Use catalog
# names without a prefix. Blank or duplicate entries inside a nonempty list are
# rejected.
# Rotation: changing the requested set requires reinstalling the application.
PUMBLE_USER_SCOPES=

# --- Credential encryption -----------------------------------------------

# ENCRYPTION_KEY (required, secret)
# Purpose: AES-256 key that encrypts stored Pumble tokens and user secrets.
# Format:  32 raw bytes, Base64 encoded.
# Generate: openssl rand -base64 32
# Rotation: bump ENCRYPTION_KEY_VERSION in the same deploy and re-encrypt
#           stored rows. Losing this key makes every stored credential
#           unreadable; they must then be re-entered by their owners.
ENCRYPTION_KEY=

# ENCRYPTION_KEY_VERSION (optional, public, default: 1, range 1-255)
# Purpose: version stamp written into every ciphertext envelope so that a
#          rotation can identify rows still using the previous key. One byte,
#          which is why 255 is the ceiling.
# Rotation: increase by one whenever ENCRYPTION_KEY changes.
ENCRYPTION_KEY_VERSION=1

# ENCRYPTION_LEGACY_KEYS (optional, secret, default: none)
# Purpose: keys that are still needed to READ rows written before a rotation.
#          They are never used to write.
# Format:  version:base64key, comma separated, for example
#          1:AAAA...,2:BBBB... Each version is 1-255 and must differ from
#          ENCRYPTION_KEY_VERSION; each key is 32 Base64 encoded bytes.
# Rotation: set this to the outgoing key when ENCRYPTION_KEY changes, run the
#           batch rotation until no row reports the old version, then remove it.
ENCRYPTION_LEGACY_KEYS=

# --- Queue concurrency ---------------------------------------------------
# Starting limits, not permanent scaling values. Range 1-200 each.

# QUEUE_CONCURRENCY_INGRESS (optional, public, default: 20)
QUEUE_CONCURRENCY_INGRESS=20

# QUEUE_CONCURRENCY_EXECUTIONS (optional, public, default: 20)
QUEUE_CONCURRENCY_EXECUTIONS=20

# QUEUE_CONCURRENCY_SCHEDULES (optional, public, default: 2)
QUEUE_CONCURRENCY_SCHEDULES=2

# QUEUE_CONCURRENCY_MAINTENANCE (optional, public, default: 2)
QUEUE_CONCURRENCY_MAINTENANCE=2

# --- Limits --------------------------------------------------------------

# MAX_REQUEST_BODY_BYTES (optional, public, default: 1048576, range 1-10485760)
# Purpose: largest inbound Pumble callback body accepted before rejection.
# Rotation: none.
MAX_REQUEST_BODY_BYTES=1048576

# OUTBOUND_HTTP_TIMEOUT_MS (optional, public, default: 10000, range 100-120000)
# Purpose: timeout applied to outbound HTTP calls made by workflow actions.
# Rotation: none.
OUTBOUND_HTTP_TIMEOUT_MS=10000

# TRUSTED_PROXIES (optional, public, default: empty)
# Purpose: comma-separated CIDRs of reverse proxies allowed to set X-Forwarded-For.
# An empty value ignores forwarding headers. Rotation: none.
# TRUSTED_PROXIES=10.0.0.0/8

# LIMIT_WORKFLOW_NODES (optional, public, default: 50, max 100)
LIMIT_WORKFLOW_NODES=50

# LIMIT_BRANCH_DEPTH (optional, public, default: 8, max 16)
LIMIT_BRANCH_DEPTH=8

# LIMIT_DEFINITION_BYTES (optional, public, default: 262144, max 1048576)
LIMIT_DEFINITION_BYTES=262144

# LIMIT_ACTIVE_WORKFLOWS (optional, public, default: 25, max 100)
LIMIT_ACTIVE_WORKFLOWS=25

# LIMIT_TOTAL_WORKFLOWS (optional, public, default: 100, max 400)
LIMIT_TOTAL_WORKFLOWS=100

# LIMIT_SCHEDULES (optional, public, default: 100, max 400)
LIMIT_SCHEDULES=100

# LIMIT_RUNNING_EXECUTIONS (optional, public, default: 5, max 20)
LIMIT_RUNNING_EXECUTIONS=5

# LIMIT_QUEUED_EXECUTIONS (optional, public, default: 1000, max 4000)
LIMIT_QUEUED_EXECUTIONS=1000

# LIMIT_CONTEXT_BYTES (optional, public, default: 262144, max 1048576)
LIMIT_CONTEXT_BYTES=262144

# LIMIT_TEMPLATE_SOURCE_BYTES (optional, public, default: 16384, max 65536)
LIMIT_TEMPLATE_SOURCE_BYTES=16384

# LIMIT_TEMPLATE_EXPANSION_BYTES (optional, public, default: 65536, max 262144)
LIMIT_TEMPLATE_EXPANSION_BYTES=65536

# LIMIT_WEBHOOK_BODY_BYTES (optional, public, default: 524288, max 2097152)
LIMIT_WEBHOOK_BODY_BYTES=524288

# LIMIT_HTTP_REQUEST_BYTES (optional, public, default: 262144, max 1048576)
LIMIT_HTTP_REQUEST_BYTES=262144

# LIMIT_HTTP_RESPONSE_BYTES (optional, public, default: 1048576, max 4194304)
LIMIT_HTTP_RESPONSE_BYTES=1048576

# LIMIT_REDIRECTS (optional, public, default: 3, max 3)
LIMIT_REDIRECTS=3

# LIMIT_RETRIES (optional, public, default: 5, max 5)
LIMIT_RETRIES=5

# LIMIT_DELAY_SECONDS (optional, public, default: 31536000, max 31536000)
LIMIT_DELAY_SECONDS=31536000

# LIMIT_EXECUTION_LIFETIME_SECONDS (optional, public, default: 2592000, max 2592000)
LIMIT_EXECUTION_LIFETIME_SECONDS=2592000

# LIMIT_LINEAGE_DEPTH (optional, public, default: 3, max 3)
LIMIT_LINEAGE_DEPTH=3

# LIMIT_LINEAGE_DESCENDANTS (optional, public, default: 8, max 32)
LIMIT_LINEAGE_DESCENDANTS=8

# LIMIT_CALLBACK_FAILURES_PER_MINUTE (optional, public, default: 30, max 300)
LIMIT_CALLBACK_FAILURES_PER_MINUTE=30

# LIMIT_MANUAL_RUNS_PER_MINUTE (optional, public, default: 20, max 120)
LIMIT_MANUAL_RUNS_PER_MINUTE=20

# LIMIT_EXPENSIVE_UI_PER_MINUTE (optional, public, default: 30, max 120)
LIMIT_EXPENSIVE_UI_PER_MINUTE=30
